*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.pt binary
*.joblib binary
*.npz binary
*.gz binary
*.docx binary
*.pptx binary
# Model/data provenance hashes require byte-exact Git and ZIP exports.
assets/** -text
offline/** -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
